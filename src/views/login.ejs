<%- include('partials/header') %>
<div class="min-h-[80vh] flex items-center justify-center px-6 py-12">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <div
        class="w-10 h-10 bg-white rounded-lg flex items-center justify-center mx-auto mb-4"
      >
        <i class="fas fa-link text-black text-sm"></i>
      </div>
      <h1 class="text-xl font-bold text-text-primary">Sign in</h1>
      <p class="text-sm text-text-tertiary mt-1">
        Welcome back to MakeItShorter
      </p>
    </div>

    <form id="loginForm" class="space-y-4" novalidate>
      <div class="relative">
        <input
          type="email"
          id="email"
          required
          placeholder=" "
          autocomplete="email"
          class="peer w-full px-4 pt-6 pb-2.5 bg-bg-secondary border border-border rounded-xl text-sm font-medium text-text-primary placeholder-transparent focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all duration-200"
        />
        <label
          for="email"
          class="absolute left-4 text-text-tertiary transition-all duration-200 pointer-events-none peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-[10px] peer-focus:text-accent peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-[10px]"
          style="line-height: 1"
          >Email address</label
        >
        <p class="hidden text-xs text-error mt-1 pl-1" id="emailError"></p>
      </div>

      <div class="relative">
        <input
          type="password"
          id="password"
          required
          placeholder=" "
          autocomplete="current-password"
          class="peer w-full px-4 pt-6 pb-2.5 bg-bg-secondary border border-border rounded-xl text-sm font-medium text-text-primary placeholder-transparent focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all duration-200"
        />
        <label
          for="password"
          class="absolute left-4 text-text-tertiary transition-all duration-200 pointer-events-none peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-[10px] peer-focus:text-accent peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-[10px]"
          style="line-height: 1"
          >Password</label
        >
        <button
          type="button"
          onclick="togglePassword('password', this)"
          class="absolute right-3 top-1/2 -translate-y-1/2 text-text-tertiary hover:text-text-secondary transition-colors"
          tabindex="-1"
        >
          <i class="fas fa-eye text-xs"></i>
        </button>
        <p class="hidden text-xs text-error mt-1 pl-1" id="passwordError"></p>
      </div>

      <div class="flex items-center justify-between text-xs">
        <label
          class="flex items-center gap-2 text-text-tertiary cursor-pointer"
        >
          <input
            type="checkbox"
            id="remember"
            class="w-3.5 h-3.5 rounded border-border bg-bg-secondary accent-white"
          />
          Remember me
        </label>
        <button
          type="button"
          onclick="showForgotPassword()"
          class="text-accent-light hover:underline font-medium"
        >
          Forgot password?
        </button>
      </div>

      <button type="submit" class="btn-primary w-full !py-3">
        Sign In <i class="fas fa-arrow-right ml-2 text-xs"></i>
      </button>
    </form>

    <div
      id="error"
      class="hidden mt-4 p-3 bg-error-bg border border-error/30 rounded-xl text-sm text-error flex items-start gap-2"
    >
      <i class="fas fa-exclamation-circle mt-0.5 flex-shrink-0"></i>
      <span id="errorMessage"></span>
    </div>

    <div class="flex items-center gap-3 my-6">
      <div class="flex-1 h-px bg-border"></div>
      <span class="text-xs text-text-tertiary font-medium">or</span>
      <div class="flex-1 h-px bg-border"></div>
    </div>

    <p class="text-center text-sm text-text-tertiary">
      No account?
      <a
        href="/register"
        class="text-accent-light hover:underline font-semibold"
        >Create free account</a
      >
    </p>
  </div>
</div>

<div
  id="forgotModal"
  class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-50 p-6"
  onclick="if (event.target === this) closeForgotPassword();"
>
  <div
    class="bg-bg-secondary border border-border rounded-2xl p-8 max-w-sm w-full text-center shadow-2xl"
  >
    <div
      class="w-10 h-10 bg-warning-bg rounded-full flex items-center justify-center mx-auto mb-4"
    >
      <i class="fas fa-tools text-warning"></i>
    </div>
    <h3 class="text-base font-bold text-text-primary mb-2">Coming Soon</h3>
    <p class="text-sm text-text-secondary mb-6">
      Password reset is not available yet. Contact support for help.
    </p>
    <button onclick="closeForgotPassword()" class="btn-primary w-full !py-2.5">
      Got it
    </button>
  </div>
</div>

<style>
  .peer:focus ~ label,
  .peer:not(:placeholder-shown) ~ label {
    top: 0.5rem !important;
    transform: translateY(0) !important;
    font-size: 10px !important;
    line-height: 1 !important;
  }
  .peer:focus ~ label {
    color: #0070f3 !important;
  }
  .peer-placeholder-shown ~ label {
    top: 50% !important;
    transform: translateY(-50%) !important;
    font-size: 14px !important;
    color: #737373 !important;
  }
</style>

<script>
  var emailInput = document.getElementById("email");
  var passInput = document.getElementById("password");
  var emailErr = document.getElementById("emailError");
  var passErr = document.getElementById("passwordError");

  function togglePassword(id, btn) {
    var input = document.getElementById(id);
    var icon = btn.querySelector("i");
    if (input.type === "password") {
      input.type = "text";
      icon.className = "fas fa-eye-slash text-xs";
    } else {
      input.type = "password";
      icon.className = "fas fa-eye text-xs";
    }
  }

  function showForgotPassword() {
    document.getElementById("forgotModal").classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }
  function closeForgotPassword() {
    document.getElementById("forgotModal").classList.add("hidden");
    document.body.style.overflow = "";
  }

  function isValidEmail(email) {
    return /^[a-zA-Z0-9][a-zA-Z0-9._-]*[a-zA-Z0-9]@[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*\.[a-zA-Z]{2,6}$/.test(
      email,
    );
  }

  function validateEmail() {
    var val = emailInput.value.trim();
    emailInput.classList.remove("border-error", "border-success");
    emailErr.classList.add("hidden");
    if (!val) return;
    if (!isValidEmail(val)) {
      emailErr.textContent = "Please enter a valid email";
      emailErr.classList.remove("hidden");
      emailInput.classList.add("border-error");
    } else {
      emailInput.classList.add("border-success");
    }
  }

  function validatePassword() {
    var val = passInput.value;
    passInput.classList.remove("border-error", "border-success");
    passErr.classList.add("hidden");
    if (!val) return;
    if (val.length < 1) {
      passErr.textContent = "Password is required";
      passErr.classList.remove("hidden");
      passInput.classList.add("border-error");
    } else {
      passInput.classList.add("border-success");
    }
  }

  var debouncedValidateEmail = debounce(validateEmail, 400);
  var debouncedValidatePassword = debounce(validatePassword, 400);

  emailInput.addEventListener("input", debouncedValidateEmail);
  passInput.addEventListener("input", debouncedValidatePassword);

  document
    .getElementById("loginForm")
    .addEventListener("submit", async function (e) {
      e.preventDefault();
      var valid = true;
      var email = emailInput.value.trim();
      var pass = passInput.value;

      emailInput.classList.remove("border-error", "border-success");
      passInput.classList.remove("border-error", "border-success");
      emailErr.classList.add("hidden");
      passErr.classList.add("hidden");

      if (!email) {
        emailErr.textContent = "Email is required";
        emailErr.classList.remove("hidden");
        emailInput.classList.add("border-error");
        valid = false;
      } else if (!isValidEmail(email)) {
        emailErr.textContent = "Please enter a valid email";
        emailErr.classList.remove("hidden");
        emailInput.classList.add("border-error");
        valid = false;
      }

      if (!pass) {
        passErr.textContent = "Password is required";
        passErr.classList.remove("hidden");
        passInput.classList.add("border-error");
        valid = false;
      }

      if (!valid) return;

      var btn = this.querySelector('button[type="submit"]');
      var orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML =
        '<i class="fas fa-spinner fa-spin mr-2"></i>Signing in...';

      try {
        var r = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, password: pass }),
          credentials: "include",
        });
        var d = await r.json();
        if (d.success) {
          window.location.href = "/dashboard";
        } else {
          document.getElementById("errorMessage").textContent = d.message;
          document.getElementById("error").classList.remove("hidden");
        }
      } catch (e) {
        document.getElementById("errorMessage").textContent =
          "Network error. Try again.";
        document.getElementById("error").classList.remove("hidden");
      }
      btn.disabled = false;
      btn.innerHTML = orig;
    });

  function debounce(fn, wait) {
    var timeout;
    return function () {
      var ctx = this,
        args = arguments;
      clearTimeout(timeout);
      timeout = setTimeout(function () {
        fn.apply(ctx, args);
      }, wait);
    };
  }
</script>
<%- include('partials/footer') %>
