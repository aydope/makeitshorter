<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<div class="space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-extrabold text-text-primary tracking-tight">Admin Panel</h1>
            <p class="text-sm text-text-tertiary mt-1">Welcome back, <span class="text-text-primary font-semibold"><%= user.username %></span> · <span class="text-accent-light font-semibold"><%= user.role %></span></p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="showCreateModal()" class="btn-primary !py-2.5 !px-4 !text-xs"><i class="fas fa-plus mr-2"></i>Shorten URL</button>
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="card p-5 group hover:border-accent/30 transition-all duration-300">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 bg-accent/10 rounded-lg flex items-center justify-center"><i class="fas fa-users text-accent text-xs"></i></div>
                <span class="text-[11px] text-text-tertiary uppercase tracking-wider font-bold">Users</span>
            </div>
            <p class="text-3xl font-extrabold text-text-primary" id="adminTotalUsers">0</p>
        </div>
        <div class="card p-5 group hover:border-success/30 transition-all duration-300">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 bg-success/10 rounded-lg flex items-center justify-center"><i class="fas fa-link text-success text-xs"></i></div>
                <span class="text-[11px] text-text-tertiary uppercase tracking-wider font-bold">Links</span>
            </div>
            <p class="text-3xl font-extrabold text-text-primary" id="adminTotalLinks">0</p>
        </div>
        <div class="card p-5 group hover:border-purple-400/30 transition-all duration-300">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 bg-purple-500/10 rounded-lg flex items-center justify-center"><i class="fas fa-chart-line text-purple-400 text-xs"></i></div>
                <span class="text-[11px] text-text-tertiary uppercase tracking-wider font-bold">Clicks</span>
            </div>
            <p class="text-3xl font-extrabold text-text-primary" id="adminTotalClicks">0</p>
        </div>
        <div class="card p-5 group hover:border-error/30 transition-all duration-300">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 bg-error/10 rounded-lg flex items-center justify-center"><i class="fas fa-ban text-error text-xs"></i></div>
                <span class="text-[11px] text-text-tertiary uppercase tracking-wider font-bold">Blocked</span>
            </div>
            <p class="text-3xl font-extrabold text-text-primary" id="adminBlacklistedLinks">0</p>
        </div>
        <div class="card p-5 group hover:border-warning/30 transition-all duration-300">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 bg-warning/10 rounded-lg flex items-center justify-center"><i class="fas fa-clock text-warning text-xs"></i></div>
                <span class="text-[11px] text-text-tertiary uppercase tracking-wider font-bold">Today</span>
            </div>
            <div class="flex items-end justify-between">
                <p class="text-3xl font-extrabold text-text-primary" id="adminDailyUsage">0</p>
                <span class="text-xs text-text-tertiary">/ <span id="adminDailyLimit">-</span></span>
            </div>
            <div class="w-full bg-bg-tertiary rounded-full h-1.5 mt-3 overflow-hidden">
                <div class="bg-gradient-to-r from-accent to-accent-light h-1.5 rounded-full transition-all duration-700 ease-out" id="adminDailyUsageBar" style="width:0%"></div>
            </div>
        </div>
    </div>

    <div class="card overflow-hidden">
        <div class="border-b border-border flex overflow-x-auto" id="adminTabs">
            <button class="tab-btn px-5 py-3.5 text-xs font-bold border-b-2 border-white text-text-primary transition-all" data-tab="users">Users <span class="badge bg-bg-tertiary text-text-secondary ml-2" id="usersCount">0</span></button>
            <button class="tab-btn px-5 py-3.5 text-xs font-bold border-b-2 border-transparent text-text-tertiary hover:text-text-secondary transition-all" data-tab="links">Links <span class="badge bg-bg-tertiary text-text-secondary ml-2" id="linksCount">0</span></button>
            <button class="tab-btn px-5 py-3.5 text-xs font-bold border-b-2 border-transparent text-text-tertiary hover:text-text-secondary transition-all" data-tab="blacklist">Blacklist <span class="badge bg-bg-tertiary text-text-secondary ml-2" id="blacklistCount">0</span></button>
            <button class="tab-btn px-5 py-3.5 text-xs font-bold border-b-2 border-transparent text-text-tertiary hover:text-text-secondary transition-all" data-tab="profile">Profile</button>
        </div>
        <div class="p-5">
            <div id="usersTab">
                <div class="flex gap-3 mb-4"><div class="relative flex-1"><i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-text-tertiary text-xs"></i><input type="text" id="userSearch" placeholder="Search users..." class="input-field pl-9"></div><select id="userRoleFilter" class="w-36"><option value="">All Roles</option><option value="user">User</option><option value="admin">Admin</option></select><select id="userStatusFilter" class="w-36"><option value="">All Status</option><option value="true">Active</option><option value="false">Inactive</option></select></div>
                <div class="overflow-x-auto rounded-lg border border-border"><table class="w-full"><thead><tr class="text-left text-[10px] font-bold text-text-tertiary uppercase tracking-widest border-b border-border bg-bg-tertiary/30"><th class="px-4 py-3">User</th><th class="px-4 py-3 hidden md:table-cell">Email</th><th class="px-4 py-3">Role</th><th class="px-4 py-3">Status</th><th class="px-4 py-3 text-right">Action</th></tr></thead><tbody id="usersTableBody"><tr><td colspan="5" class="text-center py-16 text-text-tertiary"><div class="flex flex-col items-center"><div class="w-10 h-10 bg-bg-tertiary rounded-xl flex items-center justify-center mb-2"><i class="fas fa-spinner fa-spin text-accent"></i></div><p class="text-xs">Loading users...</p></div></td></tr></tbody></table></div>
            </div>
            <div id="linksTab" class="hidden">
                <div class="flex gap-3 mb-4"><div class="relative flex-1"><i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-text-tertiary text-xs"></i><input type="text" id="linkSearch" placeholder="Search links..." class="input-field pl-9"></div><select id="linkStatusFilter" class="w-36"><option value="">All</option><option value="true">Active</option><option value="false">Inactive</option><option value="blacklisted">Blacklisted</option></select></div>
                <div class="overflow-x-auto rounded-lg border border-border"><table class="w-full"><thead><tr class="text-left text-[10px] font-bold text-text-tertiary uppercase tracking-widest border-b border-border bg-bg-tertiary/30"><th class="px-4 py-3">Code</th><th class="px-4 py-3 hidden md:table-cell">URL</th><th class="px-4 py-3">Owner</th><th class="px-4 py-3">Clicks</th><th class="px-4 py-3">Status</th><th class="px-4 py-3 text-right">Actions</th></tr></thead><tbody id="linksTableBody"><tr><td colspan="6" class="text-center py-16 text-text-tertiary"><div class="flex flex-col items-center"><div class="w-10 h-10 bg-bg-tertiary rounded-xl flex items-center justify-center mb-2"><i class="fas fa-spinner fa-spin text-accent"></i></div><p class="text-xs">Loading links...</p></div></td></tr></tbody></table></div>
            </div>
            <div id="blacklistTab" class="hidden">
                <div class="bg-bg-tertiary border border-border rounded-xl p-4 mb-4 text-xs text-text-secondary"><i class="fas fa-info-circle mr-2 text-accent"></i>URLs containing these patterns will be blocked when shortened.</div>
                <div class="flex gap-3 mb-4"><input type="text" id="domainInput" placeholder="Word, domain, or regex..." class="input-field flex-1 font-mono"><label class="flex items-center gap-2 text-xs text-text-secondary"><input type="checkbox" id="isRegexCheckbox" class="accent-white"> Regex</label><button onclick="addDomainToBlacklist()" class="btn-secondary !bg-error !text-white !border-error !py-2.5 !px-4 !text-xs">Block</button></div>
                <div class="overflow-x-auto rounded-lg border border-border"><table class="w-full"><thead><tr class="text-left text-[10px] font-bold text-text-tertiary uppercase tracking-widest border-b border-border bg-bg-tertiary/30"><th class="px-4 py-3">Pattern</th><th class="px-4 py-3">Type</th><th class="px-4 py-3 hidden md:table-cell">Added By</th><th class="px-4 py-3 text-right">Action</th></tr></thead><tbody id="blacklistTableBody"><tr><td colspan="4" class="text-center py-16 text-text-tertiary"><div class="flex flex-col items-center"><div class="w-10 h-10 bg-bg-tertiary rounded-xl flex items-center justify-center mb-2"><i class="fas fa-spinner fa-spin text-accent"></i></div><p class="text-xs">Loading blacklist...</p></div></td></tr></tbody></table></div>
            </div>
            <div id="profileTab" class="hidden">
                <div class="max-w-2xl mx-auto">
                    <div class="flex items-center gap-5 mb-8 pb-8 border-b border-border">
                        <div class="w-16 h-16 bg-gradient-to-br from-accent to-accent-light rounded-2xl flex items-center justify-center text-white text-xl font-extrabold shadow-lg shadow-accent/20 ring-2 ring-bg-secondary"><%= user.username.charAt(0).toUpperCase() %></div>
                        <div>
                            <h2 class="text-xl font-bold text-text-primary"><%= user.username %></h2>
                            <p class="text-sm text-text-tertiary"><%= user.email %></p>
                            <span class="badge mt-2 inline-flex items-center gap-1.5 bg-accent/15 text-accent border border-accent/30"><span class="w-1 h-1 rounded-full bg-accent"></span><%= user.role %></span>
                        </div>
                    </div>
                    <div id="adminDailyLimitInfo" class="mb-6"></div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="bg-bg-tertiary rounded-2xl p-6 border border-border">
                            <h3 class="text-sm font-bold text-text-primary mb-5 flex items-center gap-2"><i class="fas fa-user-pen text-accent text-xs"></i>Edit Profile</h3>
                            <form id="adminProfileForm" class="space-y-4" novalidate>
                                <div>
                                    <div class="relative">
                                        <input type="text" id="adminProfileUsername" value="<%= user.username %>" placeholder=" " class="peer w-full px-4 pt-6 pb-2.5 bg-bg-secondary border border-border rounded-xl text-sm font-medium text-text-primary placeholder-transparent focus:border-accent outline-none transition-all">
                                        <label class="absolute left-4 text-text-tertiary transition-all duration-200 pointer-events-none peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-[10px] peer-focus:text-accent peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-[10px]" style="line-height:1">Username</label>
                                    </div>
                                    <p class="hidden text-xs text-error mt-1 pl-1" id="adminUsernameError"></p>
                                </div>
                                <div>
                                    <div class="relative">
                                        <input type="email" id="adminProfileEmail" value="<%= user.email %>" placeholder=" " class="peer w-full px-4 pt-6 pb-2.5 bg-bg-secondary border border-border rounded-xl text-sm font-medium text-text-primary placeholder-transparent focus:border-accent outline-none transition-all">
                                        <label class="absolute left-4 text-text-tertiary transition-all duration-200 pointer-events-none peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-[10px] peer-focus:text-accent peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-[10px]" style="line-height:1">Email</label>
                                    </div>
                                    <p class="hidden text-xs text-error mt-1 pl-1" id="adminEmailError"></p>
                                </div>
                                <button type="submit" class="btn-primary !py-2.5 !px-5 !text-xs"><i class="fas fa-save mr-2"></i>Update</button>
                            </form>
                        </div>
                        <div class="bg-bg-tertiary rounded-2xl p-6 border border-border">
                            <h3 class="text-sm font-bold text-text-primary mb-5 flex items-center gap-2"><i class="fas fa-lock text-accent text-xs"></i>Password</h3>
                            <div class="space-y-3">
                                <div class="relative">
                                    <input type="password" id="adminCurrentPassword" placeholder=" " class="peer w-full px-4 pt-6 pb-2.5 bg-bg-secondary border border-border rounded-xl text-sm text-text-primary placeholder-transparent focus:border-accent outline-none transition-all">
                                    <label class="absolute left-4 text-text-tertiary transition-all duration-200 pointer-events-none peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-[10px] peer-focus:text-accent peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-[10px]" style="line-height:1">Current</label>
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="relative">
                                        <input type="password" id="adminNewPassword" placeholder=" " class="peer w-full px-4 pt-6 pb-2.5 bg-bg-secondary border border-border rounded-xl text-sm text-text-primary placeholder-transparent focus:border-accent outline-none transition-all">
                                        <label class="absolute left-4 text-text-tertiary transition-all duration-200 pointer-events-none peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-[10px] peer-focus:text-accent peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-[10px]" style="line-height:1">New</label>
                                    </div>
                                    <div class="relative">
                                        <input type="password" id="adminConfirmNewPassword" placeholder=" " class="peer w-full px-4 pt-6 pb-2.5 bg-bg-secondary border border-border rounded-xl text-sm text-text-primary placeholder-transparent focus:border-accent outline-none transition-all">
                                        <label class="absolute left-4 text-text-tertiary transition-all duration-200 pointer-events-none peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-sm peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-[10px] peer-focus:text-accent peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-[10px]" style="line-height:1">Confirm</label>
                                    </div>
                                </div>
                                <button type="button" id="adminChangePasswordBtn" class="btn-secondary w-full !py-2.5 !text-xs"><i class="fas fa-rotate mr-2"></i>Change</button>
                            </div>
                        </div>
                    </div>
                    <div id="adminProfileMessage" class="hidden mt-6 p-4 rounded-xl text-sm font-medium"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="createModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-50 p-6" onclick="if(event.target===this)closeCreateModal()">
    <div class="bg-bg-secondary border border-border rounded-2xl shadow-2xl w-full max-w-md animate-scale-in">
        <div class="flex items-center justify-between p-6 border-b border-border">
            <div><h3 class="text-base font-bold text-text-primary">Create Short Link</h3><p class="text-xs text-text-tertiary mt-0.5">Enter a URL to shorten it</p></div>
            <button onclick="closeCreateModal()" class="w-8 h-8 bg-bg-hover hover:bg-bg-tertiary rounded-lg flex items-center justify-center transition-colors"><i class="fas fa-times text-xs text-text-secondary"></i></button>
        </div>
        <form id="createLinkForm" class="p-6 space-y-4">
            <div>
                <label class="text-[11px] font-bold text-text-tertiary uppercase tracking-wider">Destination URL <span class="text-error">*</span></label>
                <div class="relative mt-1.5">
                    <i class="fas fa-link absolute left-3.5 top-1/2 -translate-y-1/2 text-text-tertiary text-xs"></i>
                    <input type="url" id="modalOriginalUrl" required placeholder="https://example.com" class="w-full pl-10 pr-4 py-3 bg-bg-tertiary border border-border rounded-xl text-sm font-medium text-text-primary placeholder:text-text-tertiary focus:border-accent outline-none transition-all font-mono">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="text-[11px] font-bold text-text-tertiary uppercase tracking-wider">Custom Code</label>
                    <div class="flex items-center mt-1.5 bg-bg-tertiary border border-border rounded-xl overflow-hidden focus-within:border-accent transition-all">
                        <span class="pl-3.5 pr-1 text-xs text-text-tertiary font-mono">/l/</span>
                        <input type="text" id="modalCustomCode" placeholder="alias" class="flex-1 py-3 pr-3.5 text-sm font-medium bg-transparent border-0 outline-none text-text-primary placeholder:text-text-tertiary font-mono">
                    </div>
                </div>
                <div>
                    <label class="text-[11px] font-bold text-text-tertiary uppercase tracking-wider">Title</label>
                    <input type="text" id="modalTitle" placeholder="Optional title" class="w-full mt-1.5 px-3.5 py-3 bg-bg-tertiary border border-border rounded-xl text-sm font-medium text-text-primary placeholder:text-text-tertiary focus:border-accent outline-none transition-all">
                </div>
            </div>
            <div id="modalError" class="hidden p-3 bg-error-bg border border-error/30 rounded-xl text-sm text-error flex items-start gap-2">
                <i class="fas fa-exclamation-circle mt-0.5 flex-shrink-0 text-xs"></i>
                <span id="modalErrorMessage"></span>
            </div>
            <div id="modalLimitInfo" class="p-3 bg-bg-tertiary border border-border rounded-xl text-xs text-text-secondary flex items-center gap-2">
                <i class="fas fa-info-circle text-accent text-xs"></i>
                <span id="modalLimitText">-</span>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="button" onclick="closeCreateModal()" class="btn-secondary flex-1 !py-3">Cancel</button>
                <button type="submit" class="btn-primary flex-1 !py-3"><i class="fas fa-wand-magic-sparkles mr-2"></i>Shorten</button>
            </div>
        </form>
    </div>
</div>

<style>
.peer:focus ~ label, .peer:not(:placeholder-shown) ~ label { top: 0.5rem !important; transform: translateY(0) !important; font-size: 10px !important; line-height: 1 !important; }
.peer:focus ~ label { color: #0070f3 !important; }
.peer-placeholder-shown ~ label { top: 50% !important; transform: translateY(-50%) !important; font-size: 14px !important; color: #737373 !important; }
</style>

<script>window.userData={_id:'<%= user._id %>',username:'<%= user.username %>',email:'<%= user.email %>',role:'<%= user.role %>',isActive:'<%= user.isActive %>'==="true"};</script>
<script>
document.addEventListener('DOMContentLoaded',function(){
    if(window.userData&&typeof initializeAdminDashboard==='function')initializeAdminDashboard(window.userData);

    var userInput = document.getElementById('adminProfileUsername');
    var emailInput = document.getElementById('adminProfileEmail');
    var userErr = document.getElementById('adminUsernameError');
    var emailErr = document.getElementById('adminEmailError');

    function isValidEmail(email) {
        if (!email || typeof email !== 'string') return false;
        email = email.trim();
        if (email.length > 254) return false;
        return /^[a-zA-Z0-9][a-zA-Z0-9._-]*[a-zA-Z0-9]@[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*\.[a-zA-Z]{2,6}$/.test(email);
    }

    function validateUsername() {
        var val = userInput.value.trim();
        userInput.classList.remove('border-error', 'border-success');
        userErr.classList.add('hidden');
        if (!val) { userErr.textContent = 'Username is required'; userErr.classList.remove('hidden'); userInput.classList.add('border-error'); }
        else if (val.length < 3) { userErr.textContent = 'Min. 3 characters'; userErr.classList.remove('hidden'); userInput.classList.add('border-error'); }
        else { userInput.classList.add('border-success'); }
    }

    function validateEmail() {
        var val = emailInput.value.trim();
        emailInput.classList.remove('border-error', 'border-success');
        emailErr.classList.add('hidden');
        if (!val) { emailErr.textContent = 'Email is required'; emailErr.classList.remove('hidden'); emailInput.classList.add('border-error'); }
        else if (!isValidEmail(val)) { emailErr.textContent = 'Valid email required'; emailErr.classList.remove('hidden'); emailInput.classList.add('border-error'); }
        else { emailInput.classList.add('border-success'); }
    }

    function debounce(fn, wait) { var t; return function() { var ctx=this, args=arguments; clearTimeout(t); t=setTimeout(function(){fn.apply(ctx,args)},wait); }; }

    if (userInput) userInput.addEventListener('input', debounce(validateUsername, 400));
    if (emailInput) emailInput.addEventListener('input', debounce(validateEmail, 400));
});

function showCreateModal(){document.getElementById('createModal').classList.remove('hidden');document.body.style.overflow='hidden'}
function closeCreateModal(){document.getElementById('createModal').classList.add('hidden');document.body.style.overflow=''}
</script>
</div>
<%- include('../partials/footer') %>